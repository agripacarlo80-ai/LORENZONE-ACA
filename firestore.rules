rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(email) {
      return email is string && email.size() >= 3 && email.size() <= 120 && email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email is string;
    }

    function isPrimaryAdmin() {
      return hasVerifiedEmail() && request.auth.token.email.lower() == 'maxsison2@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function activeTeacherCode() {
      return exists(/databases/$(database)/documents/config/accessCodes)
        ? get(/databases/$(database)/documents/config/accessCodes).data.teacherCode
        : 'SLA-TEACH-2026';
    }

    function activeAdminCode() {
      return exists(/databases/$(database)/documents/config/accessCodes)
        ? get(/databases/$(database)/documents/config/accessCodes).data.adminCode
        : 'SLA-ADMIN-2026';
    }

    function hasClaimedRole(uid, requiredRole) {
      return exists(/databases/$(database)/documents/roleClaims/$(uid)) &&
        get(/databases/$(database)/documents/roleClaims/$(uid)).data.targetRole == requiredRole &&
        (
          (requiredRole == 'admin' && get(/databases/$(database)/documents/roleClaims/$(uid)).data.accessCode == activeAdminCode()) ||
          (requiredRole == 'teacher' && get(/databases/$(database)/documents/roleClaims/$(uid)).data.accessCode == activeTeacherCode())
        );
    }

    function hasClaimedAnyFacultyRole(uid) {
      return exists(/databases/$(database)/documents/roleClaims/$(uid)) && (
        (
          get(/databases/$(database)/documents/roleClaims/$(uid)).data.targetRole == 'admin' &&
          get(/databases/$(database)/documents/roleClaims/$(uid)).data.accessCode == activeAdminCode()
        ) ||
        (
          get(/databases/$(database)/documents/roleClaims/$(uid)).data.targetRole == 'teacher' &&
          get(/databases/$(database)/documents/roleClaims/$(uid)).data.accessCode == activeTeacherCode()
        )
      );
    }

    function isAuthorizedAdmin() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/authorizedFaculty/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/authorizedFaculty/$(request.auth.token.email.lower())).data.role == 'admin';
    }

    function isConfigAdmin() {
      return isSignedIn() && (
        isPrimaryAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isAuthorizedAdmin() ||
        (
          exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isPrimaryAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isAuthorizedAdmin() ||
        hasClaimedRole(request.auth.uid, 'admin')
      );
    }

    function isAuthorizedTeacher() {
      return isSignedIn() && (
        isPrimaryAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          hasVerifiedEmail() &&
          exists(/databases/$(database)/documents/authorizedFaculty/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/authorizedFaculty/$(request.auth.token.email.lower())).data.role in ['teacher', 'admin']
        ) ||
        hasClaimedAnyFacultyRole(request.auth.uid)
      );
    }

    function isTeacher() {
      return (
        isSignedIn() &&
        exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.role in ['teacher', 'admin']
      ) || isAuthorizedTeacher();
    }

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() <= 40000
        && (
          url == '' ||
          url.matches('^data:image/(jpeg|png|webp);base64,.*') ||
          url.matches('^https://[a-zA-Z0-9._-]+googleusercontent\\.com/.*')
        );
    }

    function isValidSchoolIdPhotoUrl(url) {
      return url is string
        && url.size() >= 1
        && url.size() <= 150000
        && url.matches('^data:image/(jpeg|png|webp);base64,.*');
    }

    function isApprovedStudentOrFaculty() {
      return isTeacher() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) &&
        'approvalStatus' in get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.approvalStatus == 'approved'
      );
    }

    // --- Validation Blueprints ---
    function isValidPublicProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'role', 'petSpecies', 'petName', 'petLevel', 'petXp',
        'coins', 'outfit', 'accessory', 'petColor', 'uniformStyle', 'unlockedItems',
        'hunger', 'happiness', 'energy', 'cleanliness', 'totalScore', 'gamesPlayed',
        'correctAnswers', 'totalAnswers', 'isSleeping', 'lockedOut', 'lockReason',
        'activeGame', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'role', 'petSpecies', 'petName', 'petLevel', 'petXp',
        'coins', 'outfit', 'accessory', 'petColor', 'uniformStyle', 'unlockedItems',
        'hunger', 'happiness', 'energy', 'cleanliness', 'totalScore', 'gamesPlayed',
        'correctAnswers', 'totalAnswers', 'isSleeping', 'lockedOut', 'lockReason',
        'activeGame', 'section', 'photoUrl', 'isOnline', 'lastSeenAt', 'foodInventory',
        'sleepTickAt', 'roomBackground', 'approvalStatus', 'approvalNote', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
      && data.role in ['student', 'teacher', 'admin']
      && data.petSpecies in ['cat', 'dog', 'bunny', 'turtle', 'hamster', 'penguin']
      && data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 30
      && data.petLevel is int && data.petLevel >= 1 && data.petLevel <= 999
      && data.petXp is int && data.petXp >= 0 && data.petXp <= 1000000
      && data.coins is int && data.coins >= 0 && data.coins <= 1000000
      && data.outfit is string && data.outfit.size() >= 1 && data.outfit.size() <= 40
      && data.accessory is string && data.accessory.size() >= 1 && data.accessory.size() <= 40
      && data.petColor is string && data.petColor.size() >= 1 && data.petColor.size() <= 30
      && data.uniformStyle is string && data.uniformStyle.size() >= 1 && data.uniformStyle.size() <= 40
      && data.unlockedItems is list && data.unlockedItems.size() <= 100
      && (data.unlockedItems.size() == 0 || data.unlockedItems[0] is string)
      && data.hunger is int && data.hunger >= 0 && data.hunger <= 100
      && data.happiness is int && data.happiness >= 0 && data.happiness <= 100
      && data.energy is int && data.energy >= 0 && data.energy <= 100
      && data.cleanliness is int && data.cleanliness >= 0 && data.cleanliness <= 100
      && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 10000000
      && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000
      && data.correctAnswers is int && data.correctAnswers >= 0 && data.correctAnswers <= 1000000
      && data.totalAnswers is int && data.totalAnswers >= 0 && data.totalAnswers <= 1000000
      && data.isSleeping is bool
      && data.lockedOut is bool
      && data.lockReason is string && data.lockReason.size() <= 140
      && data.activeGame is string && data.activeGame.size() <= 60
      && (!('section' in data) || (data.section is string && data.section.size() <= 40))
      && (!('photoUrl' in data) || isValidPhotoUrl(data.photoUrl))
      && (!('isOnline' in data) || data.isOnline is bool)
      && (!('lastSeenAt' in data) || data.lastSeenAt is timestamp)
      && (!('sleepTickAt' in data) || data.sleepTickAt is timestamp)
      && (!('roomBackground' in data) || (data.roomBackground is string && data.roomBackground.size() >= 1 && data.roomBackground.size() <= 40))
      && (!('foodInventory' in data) || (data.foodInventory is map && data.foodInventory.size() <= 32))
      && (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected'])
      && (!('approvalNote' in data) || (data.approvalNote is string && data.approvalNote.size() <= 140))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'section', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'email', 'section', 'createdAt', 'updatedAt'])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
      && data.section is string && data.section.size() <= 40
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidQuizDeck(data) {
      return data.keys().hasAll([
        'id', 'title', 'subject', 'description', 'sourceType',
        'teacherId', 'teacherName', 'questions', 'isPublished', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'title', 'subject', 'description', 'sourceType',
        'teacherId', 'teacherName', 'questions', 'isPublished', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50
      && data.description is string && data.description.size() <= 240
      && data.sourceType in ['custom', 'pptx']
      && isValidId(data.teacherId)
      && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 60
      && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 50
      && data.questions[0] is map
      && data.isPublished is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidScoreRecord(data) {
      return data.keys().hasAll([
        'id', 'studentId', 'studentName', 'petName', 'petSpecies',
        'gameId', 'gameTitle', 'subject', 'deckId', 'score',
        'correctCount', 'totalCount', 'durationSeconds', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'studentId', 'studentName', 'petName', 'petSpecies',
        'gameId', 'gameTitle', 'subject', 'deckId', 'score',
        'correctCount', 'totalCount', 'durationSeconds', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.studentId)
      && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60
      && data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 30
      && data.petSpecies is string && data.petSpecies.size() >= 1 && data.petSpecies.size() <= 20
      && data.gameId is string && data.gameId.size() >= 1 && data.gameId.size() <= 40
      && data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 60
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50
      && data.deckId is string && data.deckId.size() >= 1 && data.deckId.size() <= 80
      && data.score is int && data.score >= 0 && data.score <= 100000
      && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500
      && data.totalCount is int && data.totalCount >= 0 && data.totalCount <= 500
      && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 7200
      && data.createdAt is timestamp;
    }

    function isValidAntiCheatAlert(data) {
      return data.keys().hasAll([
        'id', 'studentId', 'studentName', 'petName', 'gameId', 'gameTitle',
        'subject', 'reason', 'status', 'resolvedBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'studentId', 'studentName', 'petName', 'gameId', 'gameTitle',
        'subject', 'reason', 'status', 'resolvedBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.studentId)
      && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60
      && data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 30
      && data.gameId is string && data.gameId.size() >= 1 && data.gameId.size() <= 40
      && data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 60
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50
      && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 140
      && data.status in ['locked', 'allowed']
      && data.resolvedBy is string && data.resolvedBy.size() <= 60
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAuthorizedFaculty(data) {
      return data.keys().hasAll(['email', 'role', 'fullName', 'addedBy', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['email', 'role', 'fullName', 'addedBy', 'createdAt', 'updatedAt'])
      && isValidEmailId(data.email)
      && data.role in ['teacher', 'admin']
      && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 60
      && isValidId(data.addedBy)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAccessCodes(data) {
      return data.keys().hasAll(['teacherCode', 'adminCode', 'updatedBy', 'updatedAt'])
      && data.keys().hasOnly(['teacherCode', 'adminCode', 'updatedBy', 'updatedAt'])
      && data.teacherCode is string && data.teacherCode.size() >= 4 && data.teacherCode.size() <= 40
      && data.adminCode is string && data.adminCode.size() >= 4 && data.adminCode.size() <= 40
      && data.teacherCode != data.adminCode
      && isValidId(data.updatedBy)
      && data.updatedAt is timestamp;
    }

    function isValidRoleClaim(data) {
      return data.keys().hasAll(['uid', 'targetRole', 'accessCode', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'targetRole', 'accessCode', 'createdAt', 'updatedAt'])
      && isValidId(data.uid)
      && data.targetRole in ['teacher', 'admin']
      && data.accessCode is string && data.accessCode.size() >= 4 && data.accessCode.size() <= 40
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidClassroomSession(data) {
      return data.keys().hasAll([
        'id', 'section', 'teacherId', 'teacherName', 'gameId', 'gameTitle',
        'deckId', 'deckTitle', 'subject', 'status', 'startedAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'section', 'teacherId', 'teacherName', 'gameId', 'gameTitle',
        'deckId', 'deckTitle', 'subject', 'status', 'startedAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.section is string && data.section.size() >= 1 && data.section.size() <= 40
      && isValidId(data.teacherId)
      && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 60
      && data.gameId in [
        'lorenscape', 'on_the_run', 'brainzone', 'grab_it', 'catch_the_duck',
        'word_quest', 'math_dash', 'quiz_master', 'memory_match', 'sorting_squad', 'quick_recall',
        'four_pics_one_word'
      ]
      && data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 60
      && data.deckId is string && data.deckId.size() >= 1 && data.deckId.size() <= 80
      && data.deckTitle is string && data.deckTitle.size() >= 1 && data.deckTitle.size() <= 100
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50
      && data.status in ['active', 'ended']
      && data.startedAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSchoolIdVerification(data) {
      return data.keys().hasAll([
        'uid', 'studentName', 'email', 'section', 'schoolIdNumber',
        'idPhotoUrl', 'status', 'reviewedBy', 'reviewNote', 'submittedAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'studentName', 'email', 'section', 'schoolIdNumber',
        'idPhotoUrl', 'status', 'reviewedBy', 'reviewNote', 'submittedAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
      && data.section is string && data.section.size() <= 40
      && data.schoolIdNumber is string && data.schoolIdNumber.size() >= 2 && data.schoolIdNumber.size() <= 40
      && isValidSchoolIdPhotoUrl(data.idPhotoUrl)
      && data.status in ['pending', 'approved', 'rejected']
      && data.reviewedBy is string && data.reviewedBy.size() <= 60
      && data.reviewNote is string && data.reviewNote.size() <= 140
      && data.submittedAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSectionChangeRequest(data) {
      return data.keys().hasAll([
        'uid', 'studentName', 'currentSection', 'requestedSection', 'reason',
        'status', 'reviewedBy', 'reviewNote', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'studentName', 'currentSection', 'requestedSection', 'reason',
        'status', 'reviewedBy', 'reviewNote', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60
      && data.currentSection is string && data.currentSection.size() >= 1 && data.currentSection.size() <= 40
      && data.requestedSection is string && data.requestedSection.size() >= 1 && data.requestedSection.size() <= 40
      && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 140
      && data.status in ['pending', 'approved', 'rejected']
      && data.reviewedBy is string && data.reviewedBy.size() <= 60
      && data.reviewNote is string && data.reviewNote.size() <= 140
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
        'id', 'date', 'studentId', 'studentName', 'section',
        'status', 'source', 'markedBy', 'note', 'checkInAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'date', 'studentId', 'studentName', 'section',
        'status', 'source', 'markedBy', 'note', 'checkInAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && isValidId(data.studentId)
      && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60
      && data.section is string && data.section.size() <= 40
      && data.status in ['present', 'late', 'absent', 'excused']
      && data.source in ['auto', 'teacher']
      && data.markedBy is string && data.markedBy.size() >= 1 && data.markedBy.size() <= 60
      && data.note is string && data.note.size() <= 140
      && data.checkInAt is timestamp
      && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /test/connection {
      allow get: if true;
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, create, update, delete: if false;
    }

    match /config/{configId} {
      allow get: if isConfigAdmin() && configId == 'accessCodes';
      allow create, update: if isConfigAdmin()
        && configId == 'accessCodes'
        && isValidAccessCodes(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow list, delete: if false;
    }

    match /roleClaims/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidRoleClaim(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().targetRole != 'admin' ||
          !exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.role != 'teacher'
        )
        && (
          (incoming().targetRole == 'teacher' && incoming().accessCode == activeTeacherCode()) ||
          (incoming().targetRole == 'admin' && incoming().accessCode == activeAdminCode())
        );
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidRoleClaim(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['targetRole', 'accessCode', 'updatedAt'])
        && (
          incoming().targetRole != 'admin' ||
          !exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.role != 'teacher'
        )
        && (
          (incoming().targetRole == 'teacher' && incoming().accessCode == activeTeacherCode()) ||
          (incoming().targetRole == 'admin' && incoming().accessCode == activeAdminCode())
        );
      allow list: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /authorizedFaculty/{facultyEmail} {
      allow get: if isSignedIn() && isValidEmailId(facultyEmail) && (isAdmin() || facultyEmail == request.auth.token.email.lower());
      allow list: if isAdmin() && resource.data.role in ['teacher', 'admin'];

      allow create: if isAdmin()
        && isValidEmailId(facultyEmail)
        && isValidAuthorizedFaculty(incoming())
        && incoming().email == facultyEmail
        && incoming().role == 'teacher'
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidEmailId(facultyEmail)
        && isValidAuthorizedFaculty(incoming())
        && incoming().email == existing().email
        && incoming().role == 'teacher'
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'fullName', 'addedBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidEmailId(facultyEmail);
    }

    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.role in ['student', 'teacher', 'admin'];

      // Students start pending Admin approval; teacher/admin requires Admin authorization OR verified secret code claim
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().lockedOut == false
        && (!('lastSeenAt' in incoming()) || incoming().lastSeenAt == request.time)
        && (!('sleepTickAt' in incoming()) || incoming().sleepTickAt == request.time)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().role == 'student' &&
            'approvalStatus' in incoming() &&
            incoming().approvalStatus == 'pending' &&
            (!('approvalNote' in incoming()) || incoming().approvalNote == '')
          ) ||
          (
            incoming().role == 'teacher' &&
            isAuthorizedTeacher() &&
            (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'approved')
          ) ||
          (
            incoming().role == 'admin' &&
            isAdmin() &&
            (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'approved')
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          !('lastSeenAt' in incoming()) ||
          incoming().lastSeenAt == request.time ||
          ('lastSeenAt' in existing() && incoming().lastSeenAt == existing().lastSeenAt)
        )
        && (
          !('sleepTickAt' in incoming()) ||
          incoming().sleepTickAt == request.time ||
          ('sleepTickAt' in existing() && incoming().sleepTickAt == existing().sleepTickAt)
        )
        && (
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            (existing().lockedOut == false || incoming().lockedOut == true) &&
            (
              (!('approvalStatus' in incoming()) && !('approvalStatus' in existing())) ||
              ('approvalStatus' in incoming() && 'approvalStatus' in existing() && incoming().approvalStatus == existing().approvalStatus) ||
              ('approvalStatus' in incoming() && incoming().approvalStatus == 'pending' && (!('approvalNote' in incoming()) || incoming().approvalNote == ''))
            ) &&
            (
              !('approvalNote' in incoming()) ||
              ('approvalNote' in existing() && incoming().approvalNote == existing().approvalNote) ||
              ('approvalStatus' in incoming() && incoming().approvalStatus == 'pending' && incoming().approvalNote == '')
            ) &&
            (
              existing().role != 'student' ||
              !('section' in existing()) ||
              existing().section == '' ||
              ('section' in incoming() && incoming().section == existing().section)
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'petSpecies', 'petName', 'petLevel', 'petXp', 'coins',
              'outfit', 'accessory', 'petColor', 'uniformStyle', 'unlockedItems',
              'hunger', 'happiness', 'energy', 'cleanliness', 'totalScore',
              'gamesPlayed', 'correctAnswers', 'totalAnswers', 'isSleeping', 'sleepTickAt', 'roomBackground',
              'lockedOut', 'lockReason', 'activeGame', 'section', 'photoUrl', 'isOnline', 'lastSeenAt', 'foodInventory',
              'approvalStatus', 'approvalNote', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            existing().role != 'teacher' &&
            (
              (incoming().role == 'teacher' && isAuthorizedTeacher()) ||
              (incoming().role == 'admin' && isAdmin())
            ) &&
            (existing().lockedOut == false || incoming().lockedOut == true) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'petSpecies', 'petName', 'petLevel', 'petXp', 'coins',
              'outfit', 'accessory', 'petColor', 'uniformStyle', 'unlockedItems',
              'hunger', 'happiness', 'energy', 'cleanliness', 'totalScore',
              'gamesPlayed', 'correctAnswers', 'totalAnswers', 'isSleeping', 'sleepTickAt', 'roomBackground',
              'lockedOut', 'lockReason', 'activeGame', 'section', 'photoUrl', 'isOnline', 'lastSeenAt', 'foodInventory',
              'approvalStatus', 'approvalNote', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['lockedOut', 'lockReason', 'updatedAt']) &&
            incoming().lockedOut == false &&
            isTeacher()
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['section', 'updatedAt']) &&
            existing().role == 'student' &&
            (!('section' in existing()) || existing().section == '') &&
            isTeacher()
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['totalScore', 'coins', 'petXp', 'petLevel', 'updatedAt']) &&
            isTeacher()
          ) ||
          (
            isAdmin() &&
            (existing().role != 'teacher' || incoming().role != 'admin' || isPrimaryAdmin())
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isTeacher());
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && isValidPrivateInfo(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidId(docId)
        && isValidPrivateInfo(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'section', 'updatedAt']) &&
            (
              existing().section == '' ||
              incoming().section == existing().section ||
              (
                exists(/databases/$(database)/documents/publicProfiles/$(userId)) &&
                get(/databases/$(database)/documents/publicProfiles/$(userId)).data.role != 'student'
              )
            )
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['section', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
    }

    match /quizDecks/{deckId} {
      allow get: if isSignedIn() && isValidId(deckId) && (existing().isPublished == true || existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isPublished == true || resource.data.teacherId == request.auth.uid);

      allow create: if isTeacher()
        && isValidId(deckId)
        && isValidQuizDeck(incoming())
        && incoming().id == deckId
        && incoming().teacherId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(deckId)
        && isValidQuizDeck(incoming())
        && incoming().id == existing().id
        && incoming().teacherId == existing().teacherId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().teacherId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'subject', 'description', 'sourceType', 'questions', 'isPublished', 'updatedAt'
            ]) &&
            isTeacher()
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(deckId) && ((existing().teacherId == request.auth.uid && isTeacher()) || isAdmin());
    }

    match /scoreRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId);
      allow list: if isSignedIn() && resource.data.score >= 0;

      allow create: if isApprovedStudentOrFaculty()
        && isValidId(recordId)
        && isValidScoreRecord(incoming())
        && incoming().id == recordId
        && (incoming().studentId == request.auth.uid || isTeacher())
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /antiCheatAlerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId);
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.status in ['locked', 'allowed']);

      allow create: if isApprovedStudentOrFaculty()
        && isValidId(alertId)
        && isValidAntiCheatAlert(incoming())
        && incoming().id == alertId
        && incoming().studentId == request.auth.uid
        && incoming().status == 'locked'
        && incoming().resolvedBy == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(alertId)
        && isValidAntiCheatAlert(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'locked'
        && (
          (
            incoming().status == 'allowed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedBy', 'updatedAt']) &&
            isTeacher()
          ) ||
          isAdmin()
        );

      allow delete: if isAdmin() && isValidId(alertId);
    }

    match /classroomSessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId);
      allow list: if isSignedIn() && resource.data.status in ['active', 'ended'];

      allow create: if isTeacher()
        && isValidId(sessionId)
        && isValidClassroomSession(incoming())
        && incoming().id == sessionId
        && incoming().teacherId == request.auth.uid
        && incoming().startedAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isTeacher()
        && isValidId(sessionId)
        && isValidClassroomSession(incoming())
        && incoming().id == existing().id
        && (incoming().teacherId == request.auth.uid || isAdmin())
        && incoming().updatedAt == request.time
        && (incoming().startedAt == request.time || incoming().startedAt == existing().startedAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'section', 'teacherId', 'teacherName', 'gameId', 'gameTitle',
          'deckId', 'deckTitle', 'subject', 'status', 'startedAt', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(sessionId);
    }

    match /schoolIdVerifications/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.status in ['pending', 'approved', 'rejected'];

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidSchoolIdVerification(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().reviewedBy == ''
        && incoming().reviewNote == ''
        && incoming().submittedAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidSchoolIdVerification(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId) &&
            existing().status != 'approved' &&
            (existing().section == '' || incoming().section == existing().section) &&
            incoming().status == 'pending' &&
            incoming().reviewedBy == '' &&
            incoming().reviewNote == '' &&
            incoming().submittedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName', 'email', 'section', 'schoolIdNumber',
              'idPhotoUrl', 'status', 'reviewedBy', 'reviewNote', 'submittedAt', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().submittedAt == existing().submittedAt &&
            incoming().status in ['pending', 'approved', 'rejected'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'section', 'status', 'reviewedBy', 'reviewNote', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /sectionChangeRequests/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.status in ['pending', 'approved', 'rejected'];

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidSectionChangeRequest(incoming())
        && incoming().uid == request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && incoming().requestedSection != incoming().currentSection
        && incoming().status == 'pending'
        && incoming().reviewedBy == ''
        && incoming().reviewNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidSectionChangeRequest(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId) &&
            incoming().requestedSection != incoming().currentSection &&
            incoming().status == 'pending' &&
            incoming().reviewedBy == '' &&
            incoming().reviewNote == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName', 'currentSection', 'requestedSection', 'reason',
              'status', 'reviewedBy', 'reviewNote', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().status in ['approved', 'rejected'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'requestedSection', 'status', 'reviewedBy', 'reviewNote', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /attendanceRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && (
        isTeacher() ||
        resource == null ||
        existing().studentId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.status in ['present', 'late', 'absent', 'excused'];

      allow create: if isSignedIn()
        && isValidId(recordId)
        && isValidAttendanceRecord(incoming())
        && incoming().id == recordId
        && incoming().checkInAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            isApprovedStudentOrFaculty() &&
            incoming().studentId == request.auth.uid &&
            incoming().source == 'auto' &&
            incoming().status == 'present' &&
            incoming().note == ''
          ) ||
          (
            isTeacher() &&
            incoming().source == 'teacher'
          )
        );

      allow update: if isTeacher()
        && isValidId(recordId)
        && isValidAttendanceRecord(incoming())
        && incoming().id == existing().id
        && incoming().date == existing().date
        && incoming().studentId == existing().studentId
        && incoming().checkInAt == existing().checkInAt
        && incoming().updatedAt == request.time
        && incoming().source == 'teacher'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'studentName', 'section', 'status', 'source', 'markedBy', 'note', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(recordId);
    }
  }
}
